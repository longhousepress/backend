<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
            font-size: 15px;
            line-height: 1.5;
            padding: 48px 24px;
            max-width: 520px;
            margin: 0 auto;
        }

        h1 {
            font-size: 20px;
            font-weight: 600;
            margin-bottom: 32px;
        }

        .field {
            margin-bottom: 16px;
        }

        .label {
            font-size: 13px;
            font-weight: 600;
            opacity: 0.6;
            margin-bottom: 4px;
        }

        .value {
            font-size: 15px;
        }

        .message-box {
            background: #f5f5f5;
            padding: 16px;
            border-radius: 4px;
            margin-top: 8px;
            white-space: pre-wrap;
            font-size: 14px;
        }

        .attachment-note {
            margin-top: 32px;
            padding: 16px;
            background: #fafafa;
            border-left: 3px solid #666;
            font-size: 14px;
            opacity: 0.8;
        }

        .footer {
            margin-top: 48px;
            font-size: 13px;
            opacity: 0.35;
        }
    </style>
</head>
<body>

    <h1>New Submission</h1>

    <div class="field">
        <div class="label">Submitter</div>
        <div class="value">{{ submitter }}</div>
    </div>

    <div class="field">
        <div class="label">Type</div>
        <div class="value">{{ submission_type }}</div>
    </div>

    {% if message %}
    <div class="field">
        <div class="label">Message</div>
        <div class="message-box">{{ message }}</div>
    </div>
    {% endif %}

    <div class="attachment-note">
        📎 The manuscript is attached to this email: <strong>{{ filename }}</strong>
    </div>

    <div class="footer">Longhouse Press Submissions</div>

</body>
</html>